}

static uint32_t handle_register_typed(uint32_t type_id, void *ptr) {
    if (!ptr) return 0;
    if (type_id >= MAX_HANDLE_TYPES) return 0;
    if (g_handle_count[type_id] + 1 >= MAX_HANDLES) return 0;
    uint32_t id = ++g_handle_count[type_id];
    g_handles[type_id][id] = ptr;
    g_handle_valid[type_id][id] = true;
    return id;
}

static uint32_t handle_select_typed(uint32_t type_id, uint32_t requested) {
    if (type_id >= MAX_HANDLE_TYPES) return 0;
    if (g_handle_count[type_id] == 0) return 0;
    if (requested == 0) return g_handle_count[type_id]; /* latest */
    uint32_t idx = requested % g_handle_count[type_id];
    if (idx == 0) idx = g_handle_count[type_id];
    return idx;
}

static void *handle_get_typed(uint32_t type_id, uint32_t requested, bool allow_stale, uint32_t *out_selected) {
    uint32_t idx = handle_select_typed(type_id, requested);
    if (out_selected) *out_selected = idx;
    if (idx == 0) return NULL;
    if (type_id >= MAX_HANDLE_TYPES) return NULL;
    if (allow_stale || g_handle_valid[type_id][idx]) return g_handles[type_id][idx];
    return NULL;
}

static void handle_invalidate_typed(uint32_t type_id, uint32_t selected) {
    if (type_id >= MAX_HANDLE_TYPES) return;
    if (selected == 0 || selected > g_handle_count[type_id]) return;
    g_handle_valid[type_id][selected] = false;
}

static uint32_t scalar_register_typed(uint32_t type_id, int64_t value) {
    if (type_id >= MAX_SCALAR_TYPES) return 0;
    if (g_scalar_count[type_id] + 1 >= MAX_SCALAR_SLOTS) return 0;
    uint32_t id = ++g_scalar_count[type_id];
    g_scalars[type_id][id] = value;
    return id;
}

static bool scalar_get_typed(uint32_t type_id, uint32_t requested, int64_t *out_value) {
    if (type_id >= MAX_SCALAR_TYPES) return false;
    if (g_scalar_count[type_id] == 0) return false;
    uint32_t idx = requested;
    if (idx == 0) {
        idx = g_scalar_count[type_id]; /* latest */
    } else {
        idx = idx % g_scalar_count[type_id];
        if (idx == 0) idx = g_scalar_count[type_id];
    }
    if (idx == 0 || idx > g_scalar_count[type_id]) return false;
    if (out_value) *out_value = g_scalars[type_id][idx];
    return true;
}

static char *alloc_cstring_from_bytes(const pb_bytes_array_t *b, size_t n_override) {
    size_t n = n_override;
    if (!n && b) n = (size_t)b->size;
    char *s = (char*)malloc(n + 1);
    if (!s) return NULL;
    if (b && n) memcpy(s, b->bytes, n);
    s[n] = 0;
    return s;
}

