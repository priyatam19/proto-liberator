static bool cov_signal_enabled(void) {
    const char *raw = getenv("PROTO_LIBERATOR_COV_SIGNAL");
    if (!raw || !raw[0]) return true;
    char *end = NULL;
    long v = strtol(raw, &end, 10);
    if (end == raw) return true;
    return v != 0;
}

static void cov_tracker_init_once(void) {
    if (g_cov_tracker_init) return;
    g_cov_tracker_init = true;
    if (!cov_signal_enabled()) return;
    if (!__start___sancov_cntrs || !__stop___sancov_cntrs) return;
    if (__stop___sancov_cntrs <= __start___sancov_cntrs) return;
    size_t n = (size_t)(__stop___sancov_cntrs - __start___sancov_cntrs);
    if (n == 0 || n > (size_t)(1u << 30)) return;
    uint8_t *seen = (uint8_t *)calloc(n, sizeof(uint8_t));
    if (!seen) return;
    g_cov_counters = __start___sancov_cntrs;
    g_cov_seen = seen;
    g_cov_counter_count = n;
    g_cov_tracker_ready = true;
}

static uint64_t collect_new_coverage_hits(void) {
    g_cov_inputs++;
    cov_tracker_init_once();
    if (!g_cov_tracker_ready || !g_cov_counters || !g_cov_seen || g_cov_counter_count == 0) {
        return 0;
    }
    uint64_t new_hits = 0;
    for (size_t i = 0; i < g_cov_counter_count; i++) {
        if (g_cov_counters[i] == 0) continue;
        if (g_cov_seen[i]) continue;
        g_cov_seen[i] = 1;
        new_hits++;
    }
    if (new_hits > 0) {
        g_cov_inputs_with_new++;
        g_cov_new_counter_hits += new_hits;
    }
    return new_hits;
}

static void ensure_dir_recursive(const char *dir) {
    if (!dir || !dir[0]) return;
    char tmp[4096];
    snprintf(tmp, sizeof(tmp), "%s", dir);
    size_t len = strlen(tmp);
    if (len == 0) return;
    if (tmp[len - 1] == '/') tmp[len - 1] = 0;
    for (char *p = tmp + 1; *p; ++p) {
        if (*p == '/') {
            *p = 0;
            mkdir(tmp, 0755);
            *p = '/';
        }
    }
    mkdir(tmp, 0755);
}

static void ensure_parent_dir(const char *path) {
    if (!path) return;
    const char *slash = strrchr(path, '/');
    if (!slash) return;
    size_t len = (size_t)(slash - path);
    if (len == 0 || len >= 4096) return;
    char dir[4096];
    memcpy(dir, path, len);
    dir[len] = 0;
    ensure_dir_recursive(dir);
}

static void api_stats_path(char *out, size_t out_sz) {
    const char *base = getenv("PROTO_LIBERATOR_API_STATS");
    if (!base || !base[0]) base = "api_stats/api_stats.json";
    pid_t pid = getpid();
    const char *dot = strrchr(base, '.');
    if (dot && strcmp(dot, ".json") == 0) {
        int prefix_len = (int)(dot - base);
        snprintf(out, out_sz, "%.*s.%d.json", prefix_len, base, (int)pid);
        return;
    }
    snprintf(out, out_sz, "%s.%d.json", base, (int)pid);
}

static void prefix_stats_inc(const char *key) {
    if (!key || !key[0]) return;
    for (uint32_t i = 0; i < g_prefix_stats_count; i++) {
        if (strcmp(g_prefix_stats[i].seq, key) == 0) {
            g_prefix_stats[i].count++;
            return;
        }
    }
    if (g_prefix_stats_count >= MAX_PREFIX_STATS) return;
    snprintf(g_prefix_stats[g_prefix_stats_count].seq, MAX_PREFIX_KEY, "%s", key);
    g_prefix_stats[g_prefix_stats_count].count = 1;
    g_prefix_stats_count++;
}

static void coverage_prefix_stats_inc(const char *key, uint64_t weight) {
    if (!key || !key[0] || weight == 0) return;
    for (uint32_t i = 0; i < g_coverage_prefix_stats_count; i++) {
        if (strcmp(g_coverage_prefix_stats[i].seq, key) == 0) {
            g_coverage_prefix_stats[i].count += weight;
            return;
        }
    }
    if (g_coverage_prefix_stats_count >= MAX_PREFIX_STATS) return;
    snprintf(g_coverage_prefix_stats[g_coverage_prefix_stats_count].seq, MAX_PREFIX_KEY, "%s", key);
    g_coverage_prefix_stats[g_coverage_prefix_stats_count].count = weight;
    g_coverage_prefix_stats_count++;
}

static void record_api_prefix(const uint32_t *seq, size_t n, size_t prefix_len, uint64_t coverage_weight) {
    if (!seq || prefix_len < 2 || prefix_len > n) return;
    char key[MAX_PREFIX_KEY];
    key[0] = 0;
    size_t off = 0;
    for (size_t i = 0; i < prefix_len; i++) {
        uint32_t idx = seq[i];
        if (idx >= API_COUNT) return;
        int wrote = snprintf(
            key + off,
            (off < sizeof(key)) ? (sizeof(key) - off) : 0,
            "%s%s",
            (i > 0) ? "," : "",
            kApiNames[idx]
        );
        if (wrote < 0) return;
        if ((size_t)wrote >= ((off < sizeof(key)) ? (sizeof(key) - off) : 0)) return;
        off += (size_t)wrote;
    }
    prefix_stats_inc(key);
    if (coverage_weight > 0) {
        coverage_prefix_stats_inc(key, coverage_weight);
    }
}

static void record_sequence_stats(const uint32_t *seq, size_t n, uint64_t coverage_weight) {
    if (!seq || n == 0) return;
    for (size_t i = 1; i < n; i++) {
        uint32_t src = seq[i - 1];
        uint32_t dst = seq[i];
        if (src < API_COUNT && dst < API_COUNT) {
            g_api_pair_counts[src][dst]++;
            if (coverage_weight > 0) {
                g_api_coverage_pair_counts[src][dst] += coverage_weight;
            }
        }
    }
    size_t max_prefix = (n < 4) ? n : 4;
    for (size_t plen = 2; plen <= max_prefix; plen++) {
        record_api_prefix(seq, n, plen, coverage_weight);
    }
}

static void write_api_stats(void) {
    if (API_COUNT == 0) return;
    char path[4096];
    api_stats_path(path, sizeof(path));
    ensure_parent_dir(path);
    FILE *f = fopen(path, "w");
    if (!f) return;

    fprintf(f, "{\n  \"apis\": [\n");
    {% for api in apis %}
    {
        size_t idx = {{ loop.index0 }};
        fprintf(
            f,
            "    {\"name\":\"%s\",\"seen\":%llu,\"executed\":%llu,\"skipped\":%llu}%s\n",
            "{{ api.name }}",
            (unsigned long long)g_api_seen[idx],
            (unsigned long long)g_api_executed[idx],
            (unsigned long long)g_api_skipped[idx],
            "{{ "," if not loop.last else "" }}"
        );
    }
    {% endfor %}
    fprintf(f, "  ],\n");

    fprintf(f, "  \"pairs\": [\n");
    bool first_pair = true;
    for (size_t src = 0; src < API_COUNT; src++) {
        for (size_t dst = 0; dst < API_COUNT; dst++) {
            uint64_t count = g_api_pair_counts[src][dst];
            if (count == 0) continue;
            if (!first_pair) fprintf(f, ",\n");
            fprintf(
                f,
                "    {\"src\":\"%s\",\"dst\":\"%s\",\"count\":%llu}",
                kApiNames[src],
                kApiNames[dst],
                (unsigned long long)count
            );
            first_pair = false;
        }
    }
    if (!first_pair) fprintf(f, "\n");
    fprintf(f, "  ],\n");

    fprintf(f, "  \"coverage_pairs\": [\n");
    bool first_cov_pair = true;
    for (size_t src = 0; src < API_COUNT; src++) {
        for (size_t dst = 0; dst < API_COUNT; dst++) {
            uint64_t count = g_api_coverage_pair_counts[src][dst];
            if (count == 0) continue;
            if (!first_cov_pair) fprintf(f, ",\n");
            fprintf(
                f,
                "    {\"src\":\"%s\",\"dst\":\"%s\",\"count\":%llu}",
                kApiNames[src],
                kApiNames[dst],
                (unsigned long long)count
            );
            first_cov_pair = false;
        }
    }
    if (!first_cov_pair) fprintf(f, "\n");
    fprintf(f, "  ],\n");

    fprintf(f, "  \"prefixes\": [\n");
    bool first_prefix = true;
    for (uint32_t i = 0; i < g_prefix_stats_count; i++) {
        if (g_prefix_stats[i].count == 0) continue;
        if (!first_prefix) fprintf(f, ",\n");
        fprintf(
            f,
            "    {\"seq\":\"%s\",\"count\":%llu}",
            g_prefix_stats[i].seq,
            (unsigned long long)g_prefix_stats[i].count
        );
        first_prefix = false;
    }
    if (!first_prefix) fprintf(f, "\n");
    fprintf(f, "  ],\n");

    fprintf(f, "  \"coverage_prefixes\": [\n");
    bool first_cov_prefix = true;
    for (uint32_t i = 0; i < g_coverage_prefix_stats_count; i++) {
        if (g_coverage_prefix_stats[i].count == 0) continue;
        if (!first_cov_prefix) fprintf(f, ",\n");
        fprintf(
            f,
            "    {\"seq\":\"%s\",\"count\":%llu}",
            g_coverage_prefix_stats[i].seq,
            (unsigned long long)g_coverage_prefix_stats[i].count
        );
        first_cov_prefix = false;
    }
    if (!first_cov_prefix) fprintf(f, "\n");
    fprintf(
        f,
        "  ],\n"
        "  \"coverage\": {\"inputs\":%llu,\"inputs_with_new\":%llu,\"new_counter_hits\":%llu,\"counter_slots\":%llu}\n}\n",
        (unsigned long long)g_cov_inputs,
