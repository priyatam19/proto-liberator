                        uint8_t bytes[{{ arg.param.struct_size }}];
                    } blob_storage_{{ arg.i }}_t;

                    blob_storage_{{ arg.i }}_t blob_{{ arg.i }};
                    memset(blob_{{ arg.i }}.bytes, 0, sizeof(blob_{{ arg.i }}.bytes));

                    const pb_bytes_array_t *b = NULL;
