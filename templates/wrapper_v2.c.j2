                    }

                    if (params->has_param_{{ arg.param.len_depends_on_index }}) {
                        desired = (size_t)arg{{ arg.param.len_depends_on_index }};
                    } else {
                        arg{{ arg.param.len_depends_on_index }} = ({{ api.args[arg.param.len_depends_on_index].c_type }})desired;
                    }

                    if (desired > avail) {
                        desired = avail;
                        arg{{ arg.param.len_depends_on_index }} = ({{ api.args[arg.param.len_depends_on_index].c_type }})desired;
                    }
                }
                {% endif %}
                {% endfor %}

                // Call API
                {% if api.return_is_void %}
                {{ api.name }}(
                {% else %}
                {{ api.return_type }} ret = {{ api.name }}(
                {% endif %}
                    {% for arg in api.args %}
                    arg{{ arg.i }}{% if not loop.last %}, {% endif %}
                    {% endfor %}
                );

                {% if api.post_call_check %}
                /* Constraint-graph post-call guards */
                {{ api.post_call_check | replace('\n', '\n                ') }}
                {% endif %}

                // Handle Return Value
                {% if api.returns_handle %}
                handle_register_typed({{ api.return_type_id }}, (void*)ret);
                {% endif %}
                {% if api.returns_scalar %}
                scalar_register_typed({{ api.return_scalar_type_id }}, (int64_t)ret);
                {% endif %}
                g_api_executed[api_idx]++;
                if (executed_api_n < (size_t){{ max_actions }}) {
                    executed_api_seq[executed_api_n++] = (uint32_t)api_idx;
                }

                // Handle Destructor
                {% if api.is_destructor %}
                /* Best-effort invalidation: if first arg was a handle, invalidate the selected entry */
                /* NOTE: heuristic only affects semantic exploration. */
                {% if api.args|length > 0 and api.args[0].param.kind == "handle" %}
                if (!allow_double_delete) {
                    uint32_t selected = handle_select_typed({{ api.args[0].param.type_id }}, params->has_param_0_handle ? params->param_0_handle : 0);
                    handle_invalidate_typed({{ api.args[0].param.type_id }}, selected);
                }
                {% endif %}
                {% endif %}

                /* Cleanup temp allocations */
                {% for arg in api.args %}
                {% if arg.is_char_ptr and (arg.param.kind == "bytes" or arg.param.kind == "bytes_array") %}
                if (arg{{ arg.i }}) free((void*)arg{{ arg.i }});
                {% endif %}
                {% endfor %}

                break;
            }
            {% endfor %}
            default:
                break;
        }
    }
    if (executed_api_n > 0) {
        uint64_t cov_weight = collect_new_coverage_hits();
        record_sequence_stats(executed_api_seq, executed_api_n, cov_weight);
    } else {
        (void)collect_new_coverage_hits();
    }

    if (g_hard_constraint_redirected) {
        fprintf(stderr, "PLB_CONSTRAINT_REDIRECTED=1\n");
    }

    free(message);
    return 0;
}
