    (void)argv;
    atexit(write_api_stats);
    return 0;
}

int LLVMFuzzerTestOneInput(const uint8_t *data, size_t size) {
    {{ fuzz_input_type }} *message = malloc(sizeof({{ fuzz_input_type }}));
    if (!message) return 0;
    
    // Initialize to zero
    memset(message, 0, sizeof({{ fuzz_input_type }}));
    
    pb_istream_t stream = pb_istream_from_buffer(data, size);

    if (!pb_decode(&stream, {{ fuzz_input_type }}_fields, message)) {
        free(message);
        return 0;
    }

    /* Reset handles for each run */
    memset(g_handle_count, 0, sizeof(g_handle_count));
    memset(g_handles, 0, sizeof(g_handles));
    memset(g_handle_valid, 0, sizeof(g_handle_valid));
    memset(g_scalar_count, 0, sizeof(g_scalar_count));
    memset(g_scalars, 0, sizeof(g_scalars));
    g_hard_constraint_redirected = false;

    /* Dynamic Dispatch Loop */
    uint32_t executed_api_seq[{{ max_actions }}];
    size_t executed_api_n = 0;
    for (size_t i = 0; i < message->{{ actions_field }}_count; i++) {
        const {{ action_type }} *action = &message->{{ actions_field }}[i];
        
        switch (action->which_{{ action_oneof_field }}) {
            {% for api in apis %}
            case {{ api.oneof_tag }}: {
                /* {{ api.name }} */
                const size_t api_idx = {{ loop.index0 }};
                g_api_seen[api_idx]++;
                const {{ api.struct_type }} *params = &action->{{ action_oneof_field }}.{{ api.field_name }};

                bool allow_stale = false;
                bool allow_double_delete = false;
                {% if api.has_skip_dependency_check %}
                if (params->has_skip_dependency_check && params->skip_dependency_check) {
                    allow_stale = true;
                }
                {% endif %}
                {% if api.has_allow_double_delete %}
                if (params->has_allow_double_delete && params->allow_double_delete) {
                    allow_double_delete = true;
                    allow_stale = true;
                }
                {% endif %}

                /* Argument conversions (protobuf -> C) */
                {% for arg in api.args %}
                {{ arg.c_type }} arg{{ arg.i }};
                memset(&arg{{ arg.i }}, 0, sizeof(arg{{ arg.i }}));

                {% if arg.param.kind == "scalar" %}
                {% if arg.scalar_slot_enabled %}
                {
                    uint32_t requested_slot = params->has_{{ arg.param.slot_field }} ? params->{{ arg.param.slot_field }} : 0;
                    int64_t slot_value = 0;
                    if (scalar_get_typed({{ arg.scalar_type_id }}, requested_slot, &slot_value)) {
                        arg{{ arg.i }} = ({{ arg.c_type }})slot_value;
                    } else if (params->has_param_{{ arg.i }}) {
                        arg{{ arg.i }} = ({{ arg.c_type }})params->param_{{ arg.i }};
                    }
                }
                {% elif arg.scalar_pool_enabled %}
                {
                    int64_t slot_value = 0;
                    if (scalar_get_typed({{ arg.scalar_type_id }}, 0, &slot_value)) {
                        arg{{ arg.i }} = ({{ arg.c_type }})slot_value;
                    } else if (params->has_param_{{ arg.i }}) {
                        arg{{ arg.i }} = ({{ arg.c_type }})params->param_{{ arg.i }};
                    }
                }
                {% else %}
                if (params->has_param_{{ arg.i }}) {
                    arg{{ arg.i }} = ({{ arg.c_type }})params->param_{{ arg.i }};
                }
                {% endif %}
                {% elif arg.param.kind == "handle" %}
                {
                    bool is_null = false;
                    {% if arg.param.has_is_null %}
                    if (params->has_param_{{ arg.i }}_is_null && params->param_{{ arg.i }}_is_null) is_null = true;
                    {% endif %}
                    uint32_t hid = params->has_param_{{ arg.i }}_handle ? params->param_{{ arg.i }}_handle : 0;
                    uint32_t selected = 0;
                    void *ptr = NULL;
                    if (!is_null) {
