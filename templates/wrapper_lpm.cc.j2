static void handles_reset() {
    for (size_t t = 0; t < (size_t)HT__COUNT; t++) {
        g_tables[t].count = 0;
        std::memset(g_tables[t].handles, 0, sizeof(g_tables[t].handles));
        std::memset(g_tables[t].valid, 0, sizeof(g_tables[t].valid));
