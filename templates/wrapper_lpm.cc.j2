    int live[static_cast<int>(HT__COUNT)] = {};
    int inserted = 0;
    bool changed = false;
    uint32_t rng = plb_mix(static_cast<uint32_t>(seed) ^ 0x5db49cc3U);

    std::vector<{{ package_name }}::{{ action_type }}> out;
    out.reserve(n + max_inserts);

    for (int i = 0; i < n; i++) {
        const auto& action = msg->{{ actions_field }}(i);
        int case_id = static_cast<int>(action.{{ action_oneof_field }}_case());
        std::vector<int> req = plb_required_types(case_id);

        // Repair missing prerequisites by inserting producers first.
        for (int t : req) {
            if (t < 0 || t >= static_cast<int>(HT__COUNT)) continue;
            while (live[t] <= 0 && inserted < max_inserts) {
                {{ package_name }}::{{ action_type }} producer;
                if (!plb_make_producer(t, &producer)) break;
                if (plb_env_int("PROTO_LIBERATOR_EFFECTIVE_ARG_REUSE", 1) != 0) {
                    (void)plb_try_apply_cached_params(&producer, &rng);
                }
                out.push_back(std::move(producer));
                live[t] += 1;
                inserted += 1;
                changed = true;
            }
