        // Strict mode: never emit hard-invalid action when deps are still missing.
        bool missing = false;
        for (int t : req) {
            if (t < 0 || t >= static_cast<int>(HT__COUNT)) continue;
            if (live[t] <= 0) {
                missing = true;
                break;
            }
        }
        if (missing) {
            changed = true;
            continue;
        }

        out.push_back(action);

        int prod = plb_produced_type(case_id);
        if (prod >= 0 && prod < static_cast<int>(HT__COUNT)) {
            live[prod] += 1;
        }

        int del = plb_deleted_type(case_id);
        if (del >= 0 && del < static_cast<int>(HT__COUNT) && live[del] > 0) {
            live[del] -= 1;
        }
    }

    if (!changed && out.size() == static_cast<size_t>(n)) return false;

    msg->mutable_{{ actions_field }}()->Clear();
    for (auto& a : out) {
        if (msg->{{ actions_field }}_size() >= static_cast<int>({{ max_actions }})) break;
        *msg->add_{{ actions_field }}() = std::move(a);
    }
    return true;
}

