        }

        out.push_back(action);

        int prod = plb_produced_type(case_id);
        if (prod >= 0) produced.insert(prod);
    }

    if (inserts <= 0) return 0;

    msg->mutable_{{ actions_field }}()->Clear();
    for (auto& a : out) {
        if (msg->{{ actions_field }}_size() >= (int){{ max_actions }}) break;
        *msg->add_{{ actions_field }}() = std::move(a);
    }
    return inserts;
}

