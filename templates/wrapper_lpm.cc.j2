                    }
                    {% endif %}

                    arg_{{ arg.i }} = ({{ arg.c_type }})(cstrs_{{ arg.i }}.empty() ? nullptr : cstrs_{{ arg.i }}.data());
                    {% elif arg.is_char_ptr %}
                    // Ensure NUL termination after clamping.
                    storage_{{ arg.i }}.resize(n_{{ arg.i }} + 1);
                    storage_{{ arg.i }}[n_{{ arg.i }}] = 0;
                    {% endif %}
                    {% if not arg.is_char_ptr_ptr %}
                    arg_{{ arg.i }} = ({{ arg.c_type }})(storage_{{ arg.i }}.data());
                    {% endif %}
                }
                {% else %}
                /* non-pointer bytes -> 0 */
                {% endif %}
                {% elif arg.param.kind == "struct_blob" %}
                if (is_null_{{ arg.i }} || blob_{{ arg.i }} == nullptr) {
                    arg_{{ arg.i }} = ({{ arg.c_type }})nullptr;
                } else {
                    arg_{{ arg.i }} = ({{ arg.c_type }})blob_{{ arg.i }};
                }
                {% endif %}
                {% endfor %}

                if (should_skip_call) {
                    g_api_skipped[api_idx]++;
                    break;
                }

                // Call
                {% if not api.return_is_void %}
                auto ret = {{ api.name }}(
                {% else %}
                {{ api.name }}(
                {% endif %}
                    {% for arg in api.args %}
                    arg_{{ arg.i }}{% if not loop.last %}, {% endif %}
                    {% endfor %}
                );

                {% if api.post_call_check %}
                // Constraint-graph post-call guards
                {{ api.post_call_check | replace('\n', '\n                ') }}
                {% endif %}

                // Handle return
                {% if api.returns_handle %}
                handle_register_typed({{ api.return_type_id }}, (void*)ret);
                if (plb_handle_is_valid(ret)) {
                    plb_cache_record_params(
                        static_cast<int>({{ package_name }}::{{ action_type }}::k{{ api.field_name.replace('_', ' ').title().replace(' ', '') }}),
                        params
                    );
                }
                {% endif %}
                {% if api.returns_scalar %}
                scalar_register_typed({{ api.return_scalar_type_id }}, (int64_t)ret);
                {% endif %}
                g_api_executed[api_idx]++;
                executed_api_seq.push_back((uint32_t)api_idx);

                // Handle destruction
                {% if api.is_destructor %}
                /* Best-effort invalidation: if first handle arg was used, invalidate unless double-delete allowed. */
                {% set ns = namespace(first_handle=None) %}
                {% for arg in api.args %}
                {% if ns.first_handle is none and arg.param.kind == "handle" %}
                {% set ns.first_handle = arg.i %}
                {% endif %}
                {% endfor %}
                {% if ns.first_handle is not none %}
                if (!allow_double_delete) {
                    handle_invalidate_typed({{ api.args[ns.first_handle].param.type_id }}, sel_{{ ns.first_handle }});
                }
                {% endif %}
                {% endif %}

                break;
            }
            {% endfor %}
            default:
                break;
        }
    }
    if (!executed_api_seq.empty()) {
        uint64_t cov_weight = collect_new_coverage_hits();
        record_sequence_stats(executed_api_seq.data(), executed_api_seq.size(), cov_weight);
    } else {
        (void)collect_new_coverage_hits();
    }
    if (g_hard_constraint_redirected) {
        std::fprintf(stderr, "PLB_CONSTRAINT_REDIRECTED=1\n");
    }
