                    if (!is_null_{{ arg.i }} && params.has_param_{{ arg.i }}_blob()) {
                        const auto& bytes_{{ arg.i }} = params.param_{{ arg.i }}_blob();
                        const size_t n = std::min((size_t)bytes_{{ arg.i }}.size(), blob_size);
                        if (n) std::memcpy(blob_{{ arg.i }}, bytes_{{ arg.i }}.data(), n);
                    }
                }
                {% endif %}
                {% endfor %}
                {% if api.pre_call_guards %}
                // Constraint-graph pre-call guards
                {% for guard in api.pre_call_guards %}
                {{ guard | replace('\n', '\n                ') }}
                {% endfor %}
                {% endif %}
                {% if harness_style != "simple" %}
                // Enforce len_depends_on: clamp buffers to dependent length, and infer missing lengths.
                {% for arg in api.args %}
                {% if (arg.param.kind == "bytes" or arg.param.kind == "bytes_array") and arg.param.len_depends_on_index is not none and not arg.is_char_ptr_ptr %}
                {
                    const int dep = {{ arg.param.len_depends_on_index }};
                    (void)dep;
                    size_t desired = n_{{ arg.i }};
                    if (params.has_param_{{ arg.param.len_depends_on_index }}()) {
                        long long desired_ll = (long long)arg_{{ arg.param.len_depends_on_index }};
                        if (desired_ll < 0) desired_ll = 0;
                        desired = (size_t)desired_ll;
                    } else {
                        // Infer missing length from provided buffer.
                        arg_{{ arg.param.len_depends_on_index }} = (decltype(arg_{{ arg.param.len_depends_on_index }}))desired;
                    }
                    if (desired > n_{{ arg.i }}) {
                        if (resize_bytes && has_param_{{ arg.i }} && !is_null_{{ arg.i }}) {
                            storage_{{ arg.i }}.resize(desired, 0);
                            n_{{ arg.i }} = desired;
                        } else {
                            desired = n_{{ arg.i }};
                            arg_{{ arg.param.len_depends_on_index }} =
                                (decltype(arg_{{ arg.param.len_depends_on_index }}))desired;
                        }
                    }
                    if (desired < n_{{ arg.i }}) {
                        storage_{{ arg.i }}.resize(desired);
                        n_{{ arg.i }} = desired;
                    }
                }
                {% endif %}
                {% endfor %}
                {% endif %}

                // Finalize pointer arguments from storage (after potential clamps/resizes).
                {% for arg in api.args %}
                {% if arg.param.kind == "bytes" or arg.param.kind == "bytes_array" %}
                {% if arg.is_pointer %}
                if (is_null_{{ arg.i }} || storage_{{ arg.i }}.empty()) {
                    arg_{{ arg.i }} = ({{ arg.c_type }})nullptr;
                } else {
                    {% if arg.is_char_ptr_ptr %}
                    // For `char **`-style args, interpret bytes as NUL-separated strings and build a pointer array.
                    // This avoids reinterpreting raw bytes as pointers (which is extremely crash-prone).
                    storage_{{ arg.i }}.resize(n_{{ arg.i }} + 1);
                    storage_{{ arg.i }}[n_{{ arg.i }}] = 0;
                    const char* base_{{ arg.i }} = (const char*)storage_{{ arg.i }}.data();
                    const char* end_{{ arg.i }} = base_{{ arg.i }} + (ptrdiff_t)n_{{ arg.i }} + 1;

                    size_t max_strings_{{ arg.i }} = 16;
                    {% if arg.param.len_depends_on_index is not none %}
                    if (params.has_param_{{ arg.param.len_depends_on_index }}()) {
                        long long desired = (long long)arg_{{ arg.param.len_depends_on_index }};
                        if (desired < 0) desired = 0;
                        max_strings_{{ arg.i }} = (size_t)desired;
                    }
                    {% endif %}
                    if (max_strings_{{ arg.i }} > 256) max_strings_{{ arg.i }} = 256;

                    cstrs_{{ arg.i }}.clear();
                    if (max_strings_{{ arg.i }} > 0) {
                        cstrs_{{ arg.i }}.reserve(max_strings_{{ arg.i }});
                        const char* p = base_{{ arg.i }};
                        cstrs_{{ arg.i }}.push_back(p);
                        while (cstrs_{{ arg.i }}.size() < max_strings_{{ arg.i }}) {
                            const void* z = std::memchr(p, 0, (size_t)(end_{{ arg.i }} - p));
                            if (!z) break;
                            p = (const char*)z + 1;
                            if (p >= end_{{ arg.i }}) break;
                            cstrs_{{ arg.i }}.push_back(p);
                        }
                    }

                    {% if arg.param.len_depends_on_index is not none %}
                    // If the length/count wasn't provided, infer it. Otherwise clamp it.
                    if (!params.has_param_{{ arg.param.len_depends_on_index }}()) {
                        arg_{{ arg.param.len_depends_on_index }} =
                            (decltype(arg_{{ arg.param.len_depends_on_index }}))cstrs_{{ arg.i }}.size();
                    } else {
                        long long desired = (long long)arg_{{ arg.param.len_depends_on_index }};
                        if (desired < 0) desired = 0;
                        if ((size_t)desired > cstrs_{{ arg.i }}.size()) {
                            arg_{{ arg.param.len_depends_on_index }} =
                                (decltype(arg_{{ arg.param.len_depends_on_index }}))cstrs_{{ arg.i }}.size();
