            default: break;
        }
        if (created && msg->{{ actions_field }}_size() < static_cast<int>({{ max_actions }})) {
            *msg->add_{{ actions_field }}() = std::move(new_action);
            present.insert(edge.dst_case);
            appended++;
            changed = true;
        }
    }
    return changed;
}

// =============================================================================
// UAF / double-free probe
// With low probability (~5%), appends a duplicate destructor call after each
// destructor found in the sequence to probe use-after-free and double-free paths.
// Opt-in: PROTO_LIBERATOR_UAF_PROBE=1
// =============================================================================
static bool plb_uaf_probe({{ package_name }}::{{ fuzz_input_type }}* msg, unsigned int seed) {
    if (!msg) return false;
    bool changed = false;
    uint32_t rng = plb_mix(static_cast<uint32_t>(seed) ^ 0xdeadbeefU);
    const int n = msg->{{ actions_field }}_size();
    for (int i = 0; i < n; i++) {
        const auto& action = msg->{{ actions_field }}(i);
        int case_id = static_cast<int>(action.{{ action_oneof_field }}_case());
        bool is_dtor = false;
        switch (case_id) {
{% for api in apis if api.is_destructor %}
            case static_cast<int>({{ package_name }}::{{ action_type }}::k{{ api.field_name.replace('_', ' ').title().replace(' ', '') }}):
                is_dtor = true; break;
{% endfor %}
            default: break;
        }
        if (!is_dtor) continue;
        rng = plb_mix(rng ^ static_cast<uint32_t>(i));
        if (static_cast<int>(rng % 100) >= 5) continue;  // 5% chance
        if (msg->{{ actions_field }}_size() >= static_cast<int>({{ max_actions }})) break;

        {{ package_name }}::{{ action_type }} dtor_copy = action;
        switch (case_id) {
{% for api in apis if api.is_destructor and api.has_allow_double_delete %}
            case static_cast<int>({{ package_name }}::{{ action_type }}::k{{ api.field_name.replace('_', ' ').title().replace(' ', '') }}):
                dtor_copy.mutable_{{ api.field_name }}()->set_allow_double_delete(true);
                break;
{% endfor %}
            default: break;
        }
        *msg->add_{{ actions_field }}() = std::move(dtor_copy);
        changed = true;
    }
    return changed;
}

// =============================================================================
// Custom mutator: protobuf-aware mutation + multi-pass semantic repair.
//
// Passes (each controlled by PROTO_LIBERATOR_* env vars, default in parens):
//   SEQ_REPAIR=1     Insert missing producer actions before consumers (Gap 3)
//   ENFORCE_HARD=1   Drop/repair hard-invalid actions so output sequence is valid
//   EFFECTIVE_ARG_REUSE=1  Reuse cached producer args from successful calls
//   NORM_HANDLES=1   Normalize handle IDs to [1, pool_size] range (Gap 1)
//   SYNC_LENGTHS=1   Resync length_override to match bytes.size() (Gap 4)
//   GRAPH_EXTEND=0   Append consumers guided by constraint graph edges (opt-in)
//   UAF_PROBE=0      Duplicate destructor calls to probe UAF paths (opt-in)
// =============================================================================
extern "C" size_t LLVMFuzzerCustomMutator(
    uint8_t* data, size_t size, size_t max_size, unsigned int seed) {
    {{ package_name }}::{{ fuzz_input_type }} msg;
    g_seq_repair_attempted++;

    size_t new_size = protobuf_mutator::libfuzzer::CustomProtoMutator(
        /*binary=*/true, data, size, max_size, seed, &msg);

    bool changed = false;

    // Pass 1: Sequence repair — insert missing producers before consumers (Gap 3).
    if (plb_env_int("PROTO_LIBERATOR_SEQ_REPAIR", 1) != 0) {
        int max_inserts = plb_env_int("PROTO_LIBERATOR_SEQ_REPAIR_MAX_INSERTS", 8);
        int inserted = plb_repair_sequence(&msg, max_inserts, seed);
        if (inserted > 0) {
            g_seq_repair_changed++;
            g_seq_repair_insertions += static_cast<uint64_t>(inserted);
            changed = true;
        }
    }

    // Pass 2: Hard validity enforcement (strict by default).
    if (plb_env_int("PROTO_LIBERATOR_ENFORCE_HARD_VALIDITY", 1) != 0) {
        int max_inserts = plb_env_int("PROTO_LIBERATOR_ENFORCE_HARD_MAX_INSERTS", 8);
        bool misuse_mode = plb_env_int("PROTO_LIBERATOR_MUTATOR_MISUSE_MODE", 0) != 0;
        if (plb_enforce_hard_validity(&msg, max_inserts, misuse_mode, seed)) changed = true;
    }

    // Pass 3: Effective-arg reuse for producers (Hopper-style).
    if (plb_env_int("PROTO_LIBERATOR_EFFECTIVE_ARG_REUSE", 1) != 0) {
        if (plb_reuse_cached_producer_args(&msg, seed)) changed = true;
    }

    // Pass 4: Handle ID normalization — remap to [1, pool_size] (Gap 1).
    if (plb_env_int("PROTO_LIBERATOR_NORM_HANDLES", 1) != 0) {
        if (plb_normalize_handles(&msg)) changed = true;
    }

    // Pass 5: Length sync — resync length_override to bytes.size() (Gap 4).
    if (plb_env_int("PROTO_LIBERATOR_SYNC_LENGTHS", 1) != 0) {
        if (plb_sync_lengths(&msg)) changed = true;
    }

    // Pass 6: Graph-guided extension — append consumers from producer_consumer edges (opt-in).
    if (plb_env_int("PROTO_LIBERATOR_GRAPH_EXTEND", 0) != 0) {
        int max_appends = plb_env_int("PROTO_LIBERATOR_GRAPH_EXTEND_MAX", 4);
        if (plb_graph_extend(&msg, max_appends, seed)) changed = true;
    }

    // Pass 7: UAF probe — duplicate destructor to probe double-free paths (opt-in).
    if (plb_env_int("PROTO_LIBERATOR_UAF_PROBE", 0) != 0) {
        if (plb_uaf_probe(&msg, seed)) changed = true;
    }

    if (!changed) return new_size;

    std::string buf;
    if (!msg.SerializeToString(&buf) || buf.size() > max_size) {
        g_seq_repair_serialize_failures++;
        return new_size;
    }
    std::memcpy(data, buf.data(), buf.size());
    return buf.size();
}

