static bool cov_signal_enabled() {
    const char* raw = std::getenv("PROTO_LIBERATOR_COV_SIGNAL");
    if (!raw || !raw[0]) return true;
    char* end = nullptr;
    long v = std::strtol(raw, &end, 10);
    if (end == raw) return true;
    return v != 0;
}

static void cov_tracker_init_once() {
    if (g_cov_tracker_init) return;
    g_cov_tracker_init = true;
    if (!cov_signal_enabled()) return;
    if (!__start___sancov_cntrs || !__stop___sancov_cntrs) return;
    if (__stop___sancov_cntrs <= __start___sancov_cntrs) return;
    size_t n = (size_t)(__stop___sancov_cntrs - __start___sancov_cntrs);
    if (n == 0 || n > (size_t)(1u << 30)) return;
    g_cov_counters = __start___sancov_cntrs;
    g_cov_counter_count = n;
    g_cov_seen.assign(n, 0);
    g_cov_tracker_ready = true;
}

static uint64_t collect_new_coverage_hits() {
    g_cov_inputs++;
    cov_tracker_init_once();
    if (!g_cov_tracker_ready || !g_cov_counters || g_cov_counter_count == 0 || g_cov_seen.empty()) {
        return 0;
    }
    uint64_t new_hits = 0;
    for (size_t i = 0; i < g_cov_counter_count; i++) {
        if (g_cov_counters[i] == 0) continue;
        if (g_cov_seen[i]) continue;
        g_cov_seen[i] = 1;
        new_hits++;
    }
    if (new_hits > 0) {
        g_cov_inputs_with_new++;
        g_cov_new_counter_hits += new_hits;
    }
    return new_hits;
}

static void record_api_pair(uint32_t src_idx, uint32_t dst_idx, uint64_t coverage_weight) {
    if (src_idx >= API_COUNT || dst_idx >= API_COUNT) return;
    g_api_pair_counts[src_idx][dst_idx]++;
    if (coverage_weight > 0) {
        g_api_coverage_pair_counts[src_idx][dst_idx] += coverage_weight;
    }
}

static void record_api_prefix(const uint32_t* seq, size_t n, size_t prefix_len, uint64_t coverage_weight) {
    if (!seq || prefix_len < 2 || prefix_len > n) return;
    std::string key;
    for (size_t i = 0; i < prefix_len; i++) {
        uint32_t idx = seq[i];
        if (idx >= API_COUNT) return;
        if (!key.empty()) key.push_back(',');
        key += kApiNames[idx];
    }
    if (!key.empty()) {
        g_prefix_counts[key]++;
        if (coverage_weight > 0) {
            g_coverage_prefix_counts[key] += coverage_weight;
        }
    }
}

static void record_sequence_stats(const uint32_t* seq, size_t n, uint64_t coverage_weight) {
    if (!seq || n == 0) return;
    for (size_t i = 1; i < n; i++) {
        record_api_pair(seq[i - 1], seq[i], coverage_weight);
    }
    const size_t max_prefix = std::min<size_t>(4, n);
    for (size_t plen = 2; plen <= max_prefix; plen++) {
        record_api_prefix(seq, n, plen, coverage_weight);
    }
}

static void ensure_dir_recursive(const char* dir) {
    if (!dir || !dir[0]) return;
    char tmp[4096];
    std::snprintf(tmp, sizeof(tmp), "%s", dir);
    size_t len = std::strlen(tmp);
    if (len == 0) return;
    if (tmp[len - 1] == '/') tmp[len - 1] = 0;
    for (char* p = tmp + 1; *p; ++p) {
        if (*p == '/') {
            *p = 0;
            mkdir(tmp, 0755);
            *p = '/';
        }
    }
    mkdir(tmp, 0755);
}

static void ensure_parent_dir(const char* path) {
    if (!path) return;
    const char* slash = std::strrchr(path, '/');
    if (!slash) return;
    size_t len = (size_t)(slash - path);
    if (len == 0 || len >= 4096) return;
    char dir[4096];
    std::memcpy(dir, path, len);
    dir[len] = 0;
    ensure_dir_recursive(dir);
}

static void api_stats_path(char* out, size_t out_sz) {
    const char* base = std::getenv("PROTO_LIBERATOR_API_STATS");
    if (!base || !base[0]) base = "api_stats/api_stats.json";
    pid_t pid = getpid();

    const char* dot = std::strrchr(base, '.');
    if (dot && std::strcmp(dot, ".json") == 0) {
        int prefix_len = (int)(dot - base);
        std::snprintf(out, out_sz, "%.*s.%d.json", prefix_len, base, (int)pid);
        return;
    }
    std::snprintf(out, out_sz, "%s.%d.json", base, (int)pid);
}

static void write_api_stats() {
    if (API_COUNT == 0) return;
    char path[4096];
    api_stats_path(path, sizeof(path));
    ensure_parent_dir(path);
    FILE* f = std::fopen(path, "w");
    if (!f) return;

    std::fprintf(f, "{\n  \"apis\": [\n");
    {% for api in apis %}
    {
        size_t idx = {{ loop.index0 }};
        std::fprintf(
            f,
            "    {\"name\":\"%s\",\"seen\":%llu,\"executed\":%llu,\"skipped\":%llu}%s\n",
            "{{ api.name }}",
            (unsigned long long)g_api_seen[idx],
            (unsigned long long)g_api_executed[idx],
            (unsigned long long)g_api_skipped[idx],
            "{{ "," if not loop.last else "" }}"
        );
    }
    {% endfor %}
    std::fprintf(f, "  ],\n");

    std::fprintf(f, "  \"pairs\": [\n");
    bool first_pair = true;
    for (size_t src = 0; src < API_COUNT; src++) {
        for (size_t dst = 0; dst < API_COUNT; dst++) {
            uint64_t count = g_api_pair_counts[src][dst];
            if (count == 0) continue;
            if (!first_pair) {
                std::fprintf(f, ",\n");
            }
            std::fprintf(
                f,
                "    {\"src\":\"%s\",\"dst\":\"%s\",\"count\":%llu}",
                kApiNames[src],
                kApiNames[dst],
                (unsigned long long)count
            );
            first_pair = false;
        }
    }
    if (!first_pair) std::fprintf(f, "\n");
    std::fprintf(f, "  ],\n");

    std::fprintf(f, "  \"coverage_pairs\": [\n");
    bool first_cov_pair = true;
    for (size_t src = 0; src < API_COUNT; src++) {
        for (size_t dst = 0; dst < API_COUNT; dst++) {
            uint64_t count = g_api_coverage_pair_counts[src][dst];
            if (count == 0) continue;
            if (!first_cov_pair) {
                std::fprintf(f, ",\n");
            }
            std::fprintf(
                f,
                "    {\"src\":\"%s\",\"dst\":\"%s\",\"count\":%llu}",
                kApiNames[src],
                kApiNames[dst],
                (unsigned long long)count
            );
            first_cov_pair = false;
        }
    }
    if (!first_cov_pair) std::fprintf(f, "\n");
    std::fprintf(f, "  ],\n");

    std::fprintf(f, "  \"prefixes\": [\n");
    bool first_prefix = true;
    for (const auto& kv : g_prefix_counts) {
        if (kv.second == 0) continue;
        if (!first_prefix) {
            std::fprintf(f, ",\n");
        }
        std::fprintf(
            f,
            "    {\"seq\":\"%s\",\"count\":%llu}",
            kv.first.c_str(),
            (unsigned long long)kv.second
        );
        first_prefix = false;
    }
    if (!first_prefix) std::fprintf(f, "\n");
    std::fprintf(f, "  ],\n");

    std::fprintf(f, "  \"coverage_prefixes\": [\n");
    bool first_cov_prefix = true;
    for (const auto& kv : g_coverage_prefix_counts) {
        if (kv.second == 0) continue;
        if (!first_cov_prefix) {
            std::fprintf(f, ",\n");
        }
        std::fprintf(
            f,
            "    {\"seq\":\"%s\",\"count\":%llu}",
            kv.first.c_str(),
            (unsigned long long)kv.second
        );
        first_cov_prefix = false;
    }
    if (!first_cov_prefix) std::fprintf(f, "\n");
    std::fprintf(f, "  ],\n");

    std::fprintf(
        f,
        "  \"coverage\": {\"inputs\":%llu,\"inputs_with_new\":%llu,\"new_counter_hits\":%llu,\"counter_slots\":%llu},\n",
        (unsigned long long)g_cov_inputs,
        (unsigned long long)g_cov_inputs_with_new,
        (unsigned long long)g_cov_new_counter_hits,
        (unsigned long long)g_cov_counter_count
    );

    std::fprintf(
        f,
        "  \"effective_arg_cache\": {\"recorded\":%llu,\"reuse_attempts\":%llu,\"reused\":%llu,\"cache_miss\":%llu}\n}\n",
        (unsigned long long)g_effective_arg_recorded,
        (unsigned long long)g_effective_arg_reuse_attempts,
        (unsigned long long)g_effective_arg_reused,
        (unsigned long long)g_effective_arg_cache_miss
    );
    std::fclose(f);
}

