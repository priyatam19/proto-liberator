static void* align_up(void* p, size_t align) {
    uintptr_t v = (uintptr_t)p;
    uintptr_t a = (uintptr_t)align;
    v = (v + (a - 1)) & ~(a - 1);
    return (void*)v;
}

static size_t choose_n_override(
    size_t available,
    bool has_override,
    uint32_t length_override,
    bool has_length,
    uint32_t length
) {
    size_t n = 0;
    if (has_override && length_override) {
        n = static_cast<size_t>(length_override);
    } else if (has_length && length) {
        n = static_cast<size_t>(length);
    } else {
        n = available;
    }
    return std::min(n, available);
}

static int env_int(const char* name, int def_val) {
    const char* val = std::getenv(name);
    if (!val || !val[0]) return def_val;
    char* end = nullptr;
    long parsed = std::strtol(val, &end, 10);
    if (end == val) return def_val;
    if (parsed < 0) return 0;
    if (parsed > INT_MAX) return INT_MAX;
    return static_cast<int>(parsed);
}

static bool env_allowlist_has(const char* list, const char* name) {
    if (!list || !list[0] || !name || !name[0]) return false;
    size_t name_len = std::strlen(name);
    const char* p = list;
    while (*p) {
        while (*p == ',' || *p == ' ' || *p == '\t' || *p == '\n') p++;
        if (!*p) break;
        const char* start = p;
        while (*p && *p != ',' && *p != ' ' && *p != '\t' && *p != '\n') p++;
        size_t len = (size_t)(p - start);
        if (len == name_len && std::strncmp(start, name, len) == 0) {
            return true;
        }
        if (*p == ',') p++;
    }
    return false;
}

static bool allow_for_api(const char* list, const char* api_name) {
    if (!list || !list[0]) return true;
    return env_allowlist_has(list, api_name);
}

static uint32_t mix_u32(uint32_t x) {
    x ^= x >> 16;
    x *= 0x7feb352dU;
    x ^= x >> 15;
    x *= 0x846ca68bU;
    x ^= x >> 16;
    return x;
}

static bool allow_with_budget(int* budget, int prob_num, int prob_den, uint32_t salt) {
    if (!budget || *budget <= 0) return false;
    if (prob_den <= 0 || prob_num <= 0) return false;
    uint32_t v = mix_u32(salt);
    if ((int)(v % (uint32_t)prob_den) >= prob_num) return false;
    --(*budget);
    return true;
}

static const bool kSimpleHarness = {{ "true" if harness_style == "simple" else "false" }};

DEFINE_BINARY_PROTO_FUZZER(const {{ package_name }}::{{ fuzz_input_type }}& input) {
    // Reset handles
    handles_reset();
    scalars_reset();
    g_hard_constraint_redirected = false;
    int null_budget_default = env_int("PROTO_LIBERATOR_NULL_BUDGET", kSimpleHarness ? INT_MAX : 1);
    int stale_budget_default = env_int("PROTO_LIBERATOR_STALE_BUDGET", kSimpleHarness ? INT_MAX : 0);
    int null_prob_num_default = env_int("PROTO_LIBERATOR_NULL_PROB_NUM", 1);
    int null_prob_den_default = env_int("PROTO_LIBERATOR_NULL_PROB_DEN", kSimpleHarness ? 1 : 16);
    int stale_prob_num_default = env_int("PROTO_LIBERATOR_STALE_PROB_NUM", 1);
    int stale_prob_den_default = env_int("PROTO_LIBERATOR_STALE_PROB_DEN", kSimpleHarness ? 1 : 64);
    int charpp_fallback_default = env_int("PROTO_LIBERATOR_CHARPP_FALLBACK", kSimpleHarness ? 1 : 0);
    int resize_bytes_default = env_int("PROTO_LIBERATOR_RESIZE_BYTES", kSimpleHarness ? 1 : 0);
    const char* null_allowlist = std::getenv("PROTO_LIBERATOR_NULL_ALLOWLIST");
    const char* stale_allowlist = std::getenv("PROTO_LIBERATOR_STALE_ALLOWLIST");

    int null_budget_api[API_COUNT];
    int stale_budget_api[API_COUNT];
    int null_prob_num_api[API_COUNT];
    int null_prob_den_api[API_COUNT];
    int stale_prob_num_api[API_COUNT];
    int stale_prob_den_api[API_COUNT];
    bool charpp_fallback_api[API_COUNT];
    bool resize_bytes_api[API_COUNT];
    bool allow_null_api[API_COUNT];
    bool allow_stale_api[API_COUNT];

    {% for api in apis %}
    null_budget_api[{{ loop.index0 }}] = env_int("PROTO_LIBERATOR_NULL_BUDGET_{{ api.field_name.upper() }}", null_budget_default);
    stale_budget_api[{{ loop.index0 }}] = env_int("PROTO_LIBERATOR_STALE_BUDGET_{{ api.field_name.upper() }}", stale_budget_default);
    null_prob_num_api[{{ loop.index0 }}] = env_int("PROTO_LIBERATOR_NULL_PROB_NUM_{{ api.field_name.upper() }}", null_prob_num_default);
    null_prob_den_api[{{ loop.index0 }}] = env_int("PROTO_LIBERATOR_NULL_PROB_DEN_{{ api.field_name.upper() }}", null_prob_den_default);
    stale_prob_num_api[{{ loop.index0 }}] = env_int("PROTO_LIBERATOR_STALE_PROB_NUM_{{ api.field_name.upper() }}", stale_prob_num_default);
    stale_prob_den_api[{{ loop.index0 }}] = env_int("PROTO_LIBERATOR_STALE_PROB_DEN_{{ api.field_name.upper() }}", stale_prob_den_default);
    charpp_fallback_api[{{ loop.index0 }}] =
        env_int("PROTO_LIBERATOR_CHARPP_FALLBACK_{{ api.field_name.upper() }}", charpp_fallback_default) != 0;
    resize_bytes_api[{{ loop.index0 }}] =
        env_int("PROTO_LIBERATOR_RESIZE_BYTES_{{ api.field_name.upper() }}", resize_bytes_default) != 0;
    allow_null_api[{{ loop.index0 }}] = allow_for_api(null_allowlist, "{{ api.field_name }}");
    allow_stale_api[{{ loop.index0 }}] = allow_for_api(stale_allowlist, "{{ api.field_name }}");
    {% endfor %}

    const int actions_n = std::min<int>(input.{{ actions_field }}_size(), (int){{ max_actions }});
    std::vector<uint32_t> executed_api_seq;
    if (actions_n > 0) executed_api_seq.reserve((size_t)actions_n);
    for (int action_idx = 0; action_idx < actions_n; action_idx++) {
        const auto& action = input.{{ actions_field }}(action_idx);
        switch (action.{{ action_oneof_field }}_case()) {
            {% for api in apis %}
            // Case for {{ api.field_name }}
            // We construct the enum value: k + CamelCase(field_name)
            // e.g. cjson_parse -> kCjsonParse
            case {{ package_name }}::{{ action_type }}::k{{ api.field_name.replace('_', ' ').title().replace(' ', '') }}: {
                const auto& params = action.{{ api.field_name }}();
                const size_t api_idx = {{ loop.index0 }};
                g_api_seen[api_idx]++;
                int* null_budget = &null_budget_api[api_idx];
                int* stale_budget = &stale_budget_api[api_idx];
                int null_prob_num = null_prob_num_api[api_idx];
                int null_prob_den = null_prob_den_api[api_idx];
                int stale_prob_num = stale_prob_num_api[api_idx];
                int stale_prob_den = stale_prob_den_api[api_idx];
                bool charpp_fallback = charpp_fallback_api[api_idx];
                bool resize_bytes = resize_bytes_api[api_idx];
                bool allow_null = allow_null_api[api_idx];
                bool allow_stale_api_call = allow_stale_api[api_idx];

                {% if api.unsupported_vararg %}
                (void)params;
                g_api_skipped[api_idx]++;
                break;
                {% endif %}

                bool should_skip_call = false;
                bool allow_stale = false;
                bool allow_double_delete = false;
                bool allow_stale_request = false;
                {% if api.has_skip_dependency_check %}
                if (params.has_skip_dependency_check() && params.skip_dependency_check()) {
                    allow_stale_request = true;
                }
                {% endif %}
                {% if api.has_allow_double_delete %}
                if (params.has_allow_double_delete() && params.allow_double_delete()) {
                    allow_double_delete = true;
                    allow_stale_request = true;
                }
                {% endif %}
                if (allow_stale_request && allow_stale_api_call) {
                    if (kSimpleHarness) {
                        allow_stale = true;
                    } else {
                        uint32_t salt = (uint32_t)action_idx ^ (uint32_t){{ loop.index0 }};
                        allow_stale = allow_with_budget(stale_budget, stale_prob_num, stale_prob_den, salt);
                    }
                }

                // Prepare arguments
                {% for arg in api.args %}
                std::remove_const<{{ arg.c_type }}>::type arg_{{ arg.i }} = {};
                {% if arg.param.kind == "handle" %}
                uint32_t sel_{{ arg.i }} = 0;
                {% if arg.is_char_ptr_ptr %}
                std::remove_pointer<{{ arg.c_type }}>::type charpp_value_{{ arg.i }} = nullptr;
                {{ arg.c_type }} charpp_out_{{ arg.i }} = &charpp_value_{{ arg.i }};
                {% endif %}
                {% elif arg.param.kind == "bytes" or arg.param.kind == "bytes_array" %}
                std::vector<uint8_t> storage_{{ arg.i }};
                size_t n_{{ arg.i }} = 0;
                bool is_null_{{ arg.i }} = false;
                bool has_param_{{ arg.i }} = false;
                {% if arg.is_char_ptr_ptr %}
                std::vector<const char*> cstrs_{{ arg.i }};
                {% endif %}
                {% elif arg.param.kind == "struct_blob" %}
                std::vector<uint8_t> storage_{{ arg.i }};
                uint8_t* blob_{{ arg.i }} = nullptr;
                bool is_null_{{ arg.i }} = false;
                {% endif %}
                {% endfor %}

                // Decode/scalar-first: parse scalar and handle selectors without allocating pointer buffers.
                {% for arg in api.args %}
                {% if arg.param.kind == "scalar" %}
                {% if arg.scalar_slot_enabled %}
                {
                    uint32_t requested_slot = params.has_{{ arg.param.slot_field }}() ? params.{{ arg.param.slot_field }}() : 0;
                    int64_t slot_value = 0;
                    if (scalar_get_typed({{ arg.scalar_type_id }}, requested_slot, &slot_value)) {
                        arg_{{ arg.i }} = ({{ arg.c_type }})slot_value;
                    } else if (params.has_param_{{ arg.i }}()) {
                        arg_{{ arg.i }} = ({{ arg.c_type }})params.param_{{ arg.i }}();
                    }
                }
                {% elif arg.scalar_pool_enabled %}
                {
                    int64_t slot_value = 0;
                    if (scalar_get_typed({{ arg.scalar_type_id }}, 0, &slot_value)) {
                        arg_{{ arg.i }} = ({{ arg.c_type }})slot_value;
                    } else if (params.has_param_{{ arg.i }}()) {
                        arg_{{ arg.i }} = ({{ arg.c_type }})params.param_{{ arg.i }}();
                    }
                }
                {% else %}
                if (params.has_param_{{ arg.i }}()) {
                    arg_{{ arg.i }} = ({{ arg.c_type }})params.param_{{ arg.i }}();
                }
                {% endif %}
                {% elif arg.param.kind == "va_list" %}
                memset(&arg_{{ arg.i }}, 0, sizeof(arg_{{ arg.i }}));
                {% elif arg.param.kind == "handle" %}
                {
                    bool is_null = false;
                    {% if arg.param.has_is_null %}
                    if (params.has_param_{{ arg.i }}_is_null() && params.param_{{ arg.i }}_is_null()) is_null = true;
                    {% endif %}
                    uint32_t hid = params.has_param_{{ arg.i }}_handle() ? params.param_{{ arg.i }}_handle() : 0;
                    void *ptr = nullptr;
                    if (is_null) {
                        if (!allow_null) {
                            should_skip_call = true;
                        } else if (!kSimpleHarness) {
                            uint32_t salt = (uint32_t)action_idx ^ (uint32_t){{ arg.i }} ^ (hid << 1);
                            if (!allow_with_budget(null_budget, null_prob_num, null_prob_den, salt)) {
                                should_skip_call = true;
                            }
                        }
                    } else {
                        ptr = handle_get_typed({{ arg.param.type_id }}, hid, allow_stale, &sel_{{ arg.i }});
                        if (ptr == nullptr) {
                            {% if arg.is_char_ptr_ptr %}
                            if (charpp_fallback) {
                                arg_{{ arg.i }} = ({{ arg.c_type }})charpp_out_{{ arg.i }};
                            } else {
                                should_skip_call = true;
                            }
                            {% else %}
                            should_skip_call = true;
                            {% endif %}
                        }
                    }
                    if (!should_skip_call) {
                        if (is_null) {
                            arg_{{ arg.i }} = ({{ arg.c_type }})nullptr;
                        } else if (ptr != nullptr) {
                            arg_{{ arg.i }} = ({{ arg.c_type }})ptr;
                        }
                    }
                }
                {% elif arg.param.kind == "bytes" or arg.param.kind == "bytes_array" %}
                {
                    {% if arg.param.has_is_null %}
                    if (params.has_param_{{ arg.i }}_is_null() && params.param_{{ arg.i }}_is_null()) is_null_{{ arg.i }} = true;
                    {% endif %}
                    if (!is_null_{{ arg.i }} && params.has_param_{{ arg.i }}()) {
                        has_param_{{ arg.i }} = true;
                        const auto& bytes_{{ arg.i }} = params.param_{{ arg.i }}();
                        size_t n = bytes_{{ arg.i }}.size();
                        {% if arg.param.kind == "bytes_array" and arg.param.has_length %}
                        if (!kSimpleHarness) {
                            n = choose_n_override(
                                bytes_{{ arg.i }}.size(),
                                params.has_param_{{ arg.i }}_length_override(),
                                params.param_{{ arg.i }}_length_override(),
                                params.has_param_{{ arg.i }}_length(),
                                params.param_{{ arg.i }}_length()
                            );
                        }
                        {% endif %}
                        storage_{{ arg.i }}.assign(bytes_{{ arg.i }}.begin(), bytes_{{ arg.i }}.begin() + n);
                        n_{{ arg.i }} = n;
                    }
                }
                {% elif arg.param.kind == "struct_blob" %}
                {
                    {% if arg.param.has_is_null %}
                    if (params.has_param_{{ arg.i }}_is_null() && params.param_{{ arg.i }}_is_null()) is_null_{{ arg.i }} = true;
                    {% endif %}
                    const size_t blob_size = (size_t){{ arg.param.struct_size }};
                    storage_{{ arg.i }}.resize(blob_size + 16);
