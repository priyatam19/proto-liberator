}

static uint32_t handle_select(uint32_t type_id, uint32_t requested) {
    if (type_id >= (uint32_t)HT__COUNT) return 0;
    HandleTable& tab = g_tables[type_id];
    if (tab.count == 0) return 0;
    if (requested == 0) return tab.count; /* latest */
